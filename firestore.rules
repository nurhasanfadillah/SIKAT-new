rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdminEmail() { return isSignedIn() && request.auth.token.email == 'nurhasanfadillah@gmail.com' && request.auth.token.email_verified == true; }
    function getUserRole() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'none';
    }
    function isSuperAdmin() { return isAdminEmail() || (isSignedIn() && getUserRole() == 'Super Admin'); }
    function isBendahara() { return isSignedIn() && getUserRole() == 'Bendahara'; }    
    function canWrite() { return isSuperAdmin() || isBendahara(); }
    
    match /users/{userId} {
      function isValidUser(data) {
        return 'nama' in data && data.nama is string && data.nama.size() <= 100
               && 'email' in data && data.email is string && data.email.size() <= 100
               && 'role' in data && data.role is string && data.role in ['Super Admin', 'Bendahara', 'Viewer'];
      }
      
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(request.resource.data) && (isSuperAdmin() || resource.data.email == request.auth.token.email);
      // Wait, let's simplify. Anyone can read, but only admin can update. And users can create their own profile initially with a default role Viewer?
      // Actually Admin only. Or initial root.
      allow update: if isSuperAdmin() && isValidUser(request.resource.data);
      allow delete: if isSuperAdmin();
    }
    
    match /transaksi_kas/{transaksiId} {
      function isValidKas(data) {
         return 'tanggal' in data && data.tanggal is string && data.tanggal.size() <= 30
                && 'jenis' in data && data.jenis is string && data.jenis in ['Pemasukan', 'Pengeluaran']
                && 'keterangan' in data && data.keterangan is string && data.keterangan.size() <= 500
                && 'nominal' in data && data.nominal is number
                && 'created_by' in data && data.created_by is string && data.created_by.size() <= 128
                && (!('sumber_dana' in data) || (data.sumber_dana is string && data.sumber_dana.size() <= 100))
                && (!('kategori' in data) || (data.kategori is string && data.kategori.size() <= 100))
                && (!('lampiran' in data) || (data.lampiran is string && data.lampiran.size() <= 2000))
                && (!('createdAt' in data) || data.createdAt is number);
      }
      
      allow get, list: if isSignedIn();
      allow create: if canWrite() && isValidId(transaksiId) && isValidKas(request.resource.data) && request.resource.data.created_by == request.auth.uid;
      allow update: if canWrite() && isValidKas(request.resource.data) && (isSuperAdmin() || resource.data.created_by == request.auth.uid) && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isSuperAdmin();
    }

    match /transaksi_talang/{transaksiId} {
      function isValidTalang(data) {
         return 'tanggal' in data && data.tanggal is string && data.tanggal.size() <= 30
                && 'akun_talang' in data && data.akun_talang is string && data.akun_talang in ['Jisoi', 'Rakka', 'Shae']
                && 'jenis' in data && data.jenis is string && data.jenis in ['Baru', 'Pelunasan', 'Transfer']
                && 'keterangan' in data && data.keterangan is string && data.keterangan.size() <= 500
                && 'nominal' in data && data.nominal is number
                && 'created_by' in data && data.created_by is string && data.created_by.size() <= 128
                && (!('unit' in data) || (data.unit is string && data.unit.size() <= 100))
                && (!('akun_tujuan' in data) || (data.akun_tujuan is string && data.akun_tujuan in ['Jisoi', 'Rakka', 'Shae']))
                && (!('createdAt' in data) || data.createdAt is number);
      }
      
      allow get, list: if isSignedIn();
      allow create: if canWrite() && isValidId(transaksiId) && isValidTalang(request.resource.data) && request.resource.data.created_by == request.auth.uid;
      allow update: if canWrite() && isValidTalang(request.resource.data) && (isSuperAdmin() || resource.data.created_by == request.auth.uid) && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isSuperAdmin();
    }
    
    match /audit_logs/{id} {
      function isValidLog(data) {
        return 'user_id' in data && data.user_id is string && data.user_id.size() <= 128
               && 'aktivitas' in data && data.aktivitas is string && data.aktivitas.size() <= 200
               && 'waktu' in data && data.waktu is string && data.waktu.size() <= 30
               && (!('tabel' in data) || (data.tabel is string && data.tabel.size() <= 100))
               && (!('data_lama' in data) || (data.data_lama is string && data.data_lama.size() <= 5000))
               && (!('data_baru' in data) || (data.data_baru is string && data.data_baru.size() <= 5000));
      }
      allow get, list: if isSuperAdmin();
      allow create: if isSignedIn() && isValidId(id) && isValidLog(request.resource.data) && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false; // Logs are immutable
    }

  }
}
