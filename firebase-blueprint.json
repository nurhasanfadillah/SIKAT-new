{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and role.",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Super Admin", "Bendahara", "Viewer"] }
      },
      "required": ["nama", "email", "role"]
    },
    "KasTransaction": {
      "title": "Kas Transaction",
      "description": "A transaction in the main Kas.",
      "type": "object",
      "properties": {
        "tanggal": { "type": "string" },
        "jenis": { "type": "string", "enum": ["Pemasukan", "Pengeluaran"] },
        "sumber_dana": { "type": "string" },
        "kategori": { "type": "string" },
        "keterangan": { "type": "string" },
        "nominal": { "type": "number" },
        "lampiran": { "type": "string" },
        "created_by": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["tanggal", "jenis", "keterangan", "nominal", "created_by"]
    },
    "TalangTransaction": {
      "title": "Talang Transaction",
      "description": "A dana talang transaction.",
      "type": "object",
      "properties": {
        "tanggal": { "type": "string" },
        "akun_talang": { "type": "string", "enum": ["Jisoi", "Rakka", "Shae"] },
        "akun_tujuan": { "type": "string", "enum": ["Jisoi", "Rakka", "Shae"] },
        "unit": { "type": "string" },
        "jenis": { "type": "string", "enum": ["Baru", "Pelunasan", "Transfer"] },
        "keterangan": { "type": "string" },
        "nominal": { "type": "number" },
        "created_by": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["tanggal", "akun_talang", "jenis", "keterangan", "nominal", "created_by"]
    },
    "AuditLog": {
       "title": "Audit Log",
       "description": "Audit log for tracking changes.",
       "type": "object",
       "properties": {
          "user_id": { "type": "string" },
          "aktivitas": { "type": "string" },
          "tabel": { "type": "string" },
          "data_lama": { "type": "string" },
          "data_baru": { "type": "string" },
          "waktu": { "type": "string" }
       },
       "required": ["user_id", "aktivitas", "waktu"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of users."
    },
    "transaksi_kas/{transaksiId}": {
      "schema": { "$ref": "#/entities/KasTransaction" },
      "description": "Collection of main Kas transactions."
    },
    "transaksi_talang/{transaksiId}": {
      "schema": { "$ref": "#/entities/TalangTransaction" },
      "description": "Collection of Talang transactions."
    },
    "audit_logs/{id}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System audit logs."
    }
  }
}
